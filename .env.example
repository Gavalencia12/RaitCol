# ─────────────────────────────────────────────────
# Django — Configuración de Seguridad
# ─────────────────────────────────────────────────
# IMPORTANTE: En producción usa False y una SECRET_KEY segura
DEBUG=False
# Genera una clave segura con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Hosts permitidos separados por coma (sin espacios)
# Ejemplo: mi-app.render.com,www.mi-dominio.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ─────────────────────────────────────────────────
# Configuración del Servidor de Correo (SMTP)
# ─────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=tu_contraseña_de_aplicacion

# Proveedores de API de correo HTTP (Opcionales para despliegue en Render)
BREVO_API_KEY=
RESEND_API_KEY=

# ─────────────────────────────────────────────────
# Mapbox Access Token (Para integración de mapas)
# IMPORTANTE: Configura restricciones de dominio en: https://account.mapbox.com/access-tokens/
# ─────────────────────────────────────────────────
MAPBOX_ACCESS_TOKEN=tu_mapbox_token_aqui

# ─────────────────────────────────────────────────
# Configuración de Base de Datos (MySQL)
# ─────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_NAME=raitcol
DB_USER=root
DB_PASSWORD=
DB_PORT=3306
